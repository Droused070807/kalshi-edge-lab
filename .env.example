# The Odds API key (free tier: 500 credits/month) - https://the-odds-api.com
ODDS_API_KEY=

# Leagues to track: nfl, nba, mlb, nhl, ncaaf (comma-separated)
LEAGUES=nfl
# Minutes between collection runs. Each league costs 2 Odds API credits per run with ODDS_REGIONS=us,eu.
# Free tier math: 1 league every 180 min = ~480 credits/month.
COLLECT_INTERVAL_MIN=180
COLLECTOR_ENABLED=true
ODDS_REGIONS=us,eu
ODDS_MIN_CREDITS=20

# Consensus quality: drop lines older than this, and require this many books when Pinnacle is absent
ODDS_MAX_AGE_MIN=30
MIN_BOOKS=3
INCLUDE_LIVE=false

# Kalshi taker fee rate. Fee per order = ceil(rate * contracts * P * (1-P)) to the cent.
# Check https://kalshi.com/fee-schedule and update if Kalshi changes it.
KALSHI_TAKER_FEE_RATE=0.07

# Research rules
SIGNAL_MIN_EDGE=0.02
PAPER_MIN_EDGE=0.05
PAPER_START_BANKROLL=10000
PAPER_MAX_POSITION_PCT=0.01
PAPER_MAX_DAILY_LOSS_PCT=0.03
WIDE_SPREAD=0.04
EARLY_HOURS=24

TIMEZONE=America/Chicago
DB_PATH=data/edgelab.db
HOST=127.0.0.1
PORT=8000
